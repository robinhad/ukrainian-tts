export ESPEAK_DATA_PATH="@DATA@"
export PATH="@ROOT@/.venv/bin:@ROOT@/vendor/espeak-ng-install/bin:${PATH}"
export PYTHONPATH="@ROOT@/..:${PYTHONPATH:-}"
# Preserve the scheduler's allocation. Outside SLURM, let CUDA discover devices.
