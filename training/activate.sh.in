#!/usr/bin/env bash
export UK_TTS_TRAINING_ROOT="@ROOT@"
export ESPNET_ROOT="@ROOT@/vendor/espnet-src"
export ESPEAK_ROOT="@ROOT@/vendor/espeak-ng-install"
